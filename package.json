{
  "name": "resound-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/postinstall-fixes.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/start-api.cjs",
    "dev:web:full": "concurrently -k \"PORT=38761 npm run dev:api\" \"npm run dev:unblock\" \"npm run dev:unblock-match\" \"VITE_API_PROXY_TARGET=http://127.0.0.1:38761 npm run dev:web\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:desktop": "node scripts/start-desktop.mjs",
    "dev:desktop:headless": "xvfb-run -a node scripts/start-desktop.mjs",
    "dev": "npm run dev:desktop",
    "build:web": "vite build",
    "build:renderer": "vite build",
    "clean:desktop": "node scripts/clean-desktop.mjs",
    "pack:desktop": "node scripts/build-desktop-dir.mjs",
    "build:desktop": "node scripts/build-linux.mjs AppImage",
    "dist:linux": "node scripts/build-linux.mjs AppImage",
    "dist:linux:deb": "node scripts/build-linux.mjs deb",
    "prepare:win-icon": "node scripts/prepare-win-icon.mjs",
    "dist:win": "node scripts/build-win.mjs nsis",
    "pack:win": "node scripts/build-win.mjs dir",
    "prepare:mac-icon": "node scripts/prepare-mac-icon.mjs",
    "dist:mac": "node scripts/build-mac.mjs dmg",
    "pack:mac": "node scripts/build-mac.mjs dir",
    "check:animated-rhythm": "node scripts/check-animated-rhythm.mjs",
    "fix:animated-rhythm": "node scripts/check-animated-rhythm.mjs --fix",
    "start": "electron .",
    "dev:unblock": "ENABLE_FLAC=true node node_modules/@unblockneteasemusic/server/app.js -p 38762 -o bodian kugou migu qq bilibili -s",
    "dev:unblock-match": "node server/unblock-match-server.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "file:_amll_dist/core/applemusic-like-lyrics-core-0.4.2.tgz",
    "@applemusic-like-lyrics/lyric": "^1.0.0",
    "@applemusic-like-lyrics/vue": "file:_amll_dist/vue/applemusic-like-lyrics-vue-0.4.2.tgz",
    "@neteasecloudmusicapienhanced/api": "4.32.1",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@tanstack/vue-query": "^5.100.14",
    "@tanstack/vue-virtual": "^3.13.24",
    "@unblockneteasemusic/server": "^0.28.0",
    "@ungap/structured-clone": "^1.3.0",
    "@yortyrh/tagpilot-lib": "^1.0.27",
    "axios": "^1.8.2",
    "bezier-easing": "^3.0.0",
    "deep-freeze": "^0.0.1",
    "flac-tagger": "^2.0.0",
    "gl-matrix": "^4.0.0-beta.2",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "jss": "^10.10.0",
    "jss-preset-default": "^10.10.0",
    "lucide-vue-next": "^0.507.0",
    "music-metadata": "^11.12.3",
    "node-id3": "^0.2.9",
    "ogl": "^1.0.11",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sql.js": "^1.14.1",
    "three": "^0.184.0",
    "threejs-components": "^0.0.19",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "electron": "42.1.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^5.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.resound.player",
    "productName": "Resound-Player",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@unblockneteasemusic/server/.yarn/**",
      "!node_modules/@unblockneteasemusic/server/.vscode/**",
      "!node_modules/@unblockneteasemusic/server/src/**/*.test.*",
      "!node_modules/@unblockneteasemusic/server/src/**/*.disabled_test.*",
      "!node_modules/@unblockneteasemusic/server/jest.config.js",
      "!node_modules/@unblockneteasemusic/server/webpack.config.js",
      "!node_modules/@unblockneteasemusic/server/Dockerfile",
      "!node_modules/@unblockneteasemusic/server/docker-compose.yml",
      "!node_modules/@unblockneteasemusic/server/generate-cert.sh",
      "!node_modules/@unblockneteasemusic/server/renew-cert.sh",
      "!node_modules/@unblockneteasemusic/server/nw.js",
      "!**/.vscode/**",
      "!**/.github/**",
      "!**/test/**",
      "!**/tests/**"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "node_modules/.pnpm/@neteasecloudmusicapienhanced+api@*/**/*",
      "node_modules/.pnpm/@unblockneteasemusic+server@*/**/*",
      "node_modules/@unblockneteasemusic/**/*",
      "node_modules/.pnpm/@neteasecloudmusicapienhanced+unblockmusic-utils@*/**/*",
      "node_modules/@neteasecloudmusicapienhanced/**/*"
    ],
    "npmRebuild": true,
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Audio;Player"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSQuitAlwaysKeepsWindows": false,
        "LSUIElement": false
      },
      "artifactName": "${name}-Mac-${arch}-${version}.${ext}"
    }
  }
}
